# FMU v6x Hardware Definition for HPM6754
# Based on SCH_v6x_fmu_hpm_2025-11-07.pdf

# Toolchain Path
env TOOLCHAIN riscv32-unknown-elf
env HPM_SDK_TOOLCHAIN_VARIANT gcc
env GNURISCV_TOOLCHAIN_PATH riscv32-gnu-toolchain/
env HPM_SOC_SERIES   HPM6700
define HAL_CANFD_SUPPORTED         0

# Board Definitions
define HAL_HPMICRO_SDCARD          1
define AP_FILESYSTEM_FATFS_ENABLED 1
define HAL_HPM_BOARD_NAME "fmuv6x_hpm"
# Flash capacity: board.h BOARD_FLASH_SIZE = (4<<20) for HPM6754IAN2 on-chip 4MB

# Serial protocol defaults — all 8 HW UARTs + USB SERIAL0
# HAL serial map (USB on): SERIAL0=USB,1=UART8,2=UART9,3=UART3,4=UART2,
#   5=UART6,6=UART1,7=UART5,8=Empty,9=UART0 debug
define HAL_UART_NUM_SERIAL_PORTS       10
define DEFAULT_SERIAL0_PROTOCOL        SerialProtocol_MAVLink2
define DEFAULT_SERIAL0_BAUD            921600
# Force USB SERIAL0 to stay MAVLink even if stored params corrupted (same as STM32 OTG)
define HAL_OTG1_CONFIG 1
define DEFAULT_SERIAL1_PROTOCOL        SerialProtocol_MAVLink2
define DEFAULT_SERIAL1_BAUD            57600
define DEFAULT_SERIAL2_PROTOCOL        SerialProtocol_MAVLink2
define DEFAULT_SERIAL2_BAUD            57600
define DEFAULT_SERIAL3_PROTOCOL        SerialProtocol_GPS
define DEFAULT_SERIAL3_BAUD            AP_SERIALMANAGER_GPS_BAUD
define DEFAULT_SERIAL4_PROTOCOL        SerialProtocol_GPS
define DEFAULT_SERIAL4_BAUD            AP_SERIALMANAGER_GPS_BAUD
define DEFAULT_SERIAL5_PROTOCOL        SerialProtocol_MAVLink2
define DEFAULT_SERIAL5_BAUD            57600
# SERIAL6 = EXTERNAL2 (UART1) — open as MAVLink for bring-up
define DEFAULT_SERIAL6_PROTOCOL        SerialProtocol_MAVLink2
define DEFAULT_SERIAL6_BAUD            57600
# SERIAL7 = UART5 RC/IO — IOMCU off, open UART so pinmux/irq/buffers init
define DEFAULT_SERIAL7_PROTOCOL        SerialProtocol_MAVLink2
define DEFAULT_SERIAL7_BAUD            1500000
# SERIAL8 = Empty placeholder (no HW)
define DEFAULT_SERIAL8_PROTOCOL        SerialProtocol_None
define DEFAULT_SERIAL8_BAUD            57600
# SERIAL9 = UART0 DEBUG (USB owns SERIAL0)
define DEFAULT_SERIAL9_PROTOCOL        SerialProtocol_MAVLink2
define DEFAULT_SERIAL9_BAUD            115200

# IOMCU on UART5 PD06/PD07 — temporarily disabled (SERIAL7 used as UART above)
define HAL_WITH_IO_MCU                 0
define HAL_HPM_IOMCU_PROBE             0

# Ethernet: ENET0 RMII + LAN8742A (stack word fix freed heap for tcpip_thread)
# MemGuard thresholds live in MemGuard.h (HAL_HPM_HEAP_* / HAL_HPM_STACK_*)
define HAL_HPM_ETH_PROBE               0
define HAL_HPM_NET_RUNTIME             1
define AP_NETWORKING_ENABLED           1
define AP_NETWORKING_BACKEND_HPM       1
define AP_NETWORKING_CONTROLS_HOST_IP_SETTINGS_ENABLED 1
define AP_NETWORKING_DHCP_AVAILABLE    1
define AP_NETWORKING_SOCKETS_ENABLED   1
# 4× NET_Pn: UDP/TCP client+server via SocketAPM(lwIP) + SerialManager
define AP_NETWORKING_REGISTER_PORT_ENABLED 1
define AP_NETWORKING_NUM_PORTS         4

define HAL_WITH_USB_VCP                    1
define HAL_WITH_SPI_OSD                    0
define AP_FILESYSTEM_FILE_WRITING_ENABLED  1
define HAL_LOGGING_ENABLED            1
define HAL_LOGGING_FILESYSTEM_ENABLED 1
define HAL_LOGGING_DATAFLASH_ENABLED 0
define HAL_LOGGING_MAVLINK_ENABLED 0
define HAL_LOGGING_BACKENDS_DEFAULT 2

# ========== SERIAL ==========
# NOTE: Order = uart_desc[] index used by UARTDriver(n). Last field is HW UART
# instance id for ISR (uart_isrN), NOT SERIAL_n.
# UART0 MUST stay at uart_desc[1] (console / SERIAL9 when USB owns SERIAL0).
#
# Schematic (SCH_v6x_fmu_hpm):
#   UART0 DEBUG PY06/07 | UART8 TELEM1 PC06/07 | UART9 TELEM2 PC11/12
#   UART3 GPS1 PC30/31  | UART2 GPS2 PC23/24   | UART6 TELEM3 PC27/28
#   UART1 EXT2 PC18/19  | UART5 RC/IO PD06/07

# UART5 - RC Input / IO MCU (uart_desc[0] -> SERIAL7)
HPMICRO_SERIAL HPM_UART5 clock_uart5 IOC_PAD_PD06 IOC_PAD_PD07 IOC_PD06_FUNC_CTL_UART5_RXD IOC_PD07_FUNC_CTL_UART5_TXD 0 0 0 0 IRQn_UART5 5

# UART0 - DEBUG Console (uart_desc[1] -> SERIAL0 without USB / SERIAL9 with USB)
HPMICRO_SERIAL HPM_UART0 clock_uart0 IOC_PAD_PY07 IOC_PAD_PY06 IOC_PY07_FUNC_CTL_UART0_RXD IOC_PY06_FUNC_CTL_UART0_TXD 0 0 PIOC_PY07_FUNC_CTL_SOC_PY_07 PIOC_PY06_FUNC_CTL_SOC_PY_06 IRQn_UART0 0

# UART8 - TELEM1 (uart_desc[2] -> SERIAL1)
HPMICRO_SERIAL HPM_UART8 clock_uart8 IOC_PAD_PC06 IOC_PAD_PC07 IOC_PC06_FUNC_CTL_UART8_RXD IOC_PC07_FUNC_CTL_UART8_TXD 0 0 0 0 IRQn_UART8 8

# UART9 - TELEM2 (uart_desc[3] -> SERIAL2)
HPMICRO_SERIAL HPM_UART9 clock_uart9 IOC_PAD_PC11 IOC_PAD_PC12 IOC_PC11_FUNC_CTL_UART9_RXD IOC_PC12_FUNC_CTL_UART9_TXD 0 0 0 0 IRQn_UART9 9

# UART3 - GPS1 (uart_desc[4] -> SERIAL3)
HPMICRO_SERIAL HPM_UART3 clock_uart3 IOC_PAD_PC30 IOC_PAD_PC31 IOC_PC30_FUNC_CTL_UART3_RXD IOC_PC31_FUNC_CTL_UART3_TXD 0 0 0 0 IRQn_UART3 3

# UART2 - GPS2 (uart_desc[5] -> SERIAL4)
HPMICRO_SERIAL HPM_UART2 clock_uart2 IOC_PAD_PC23 IOC_PAD_PC24 IOC_PC23_FUNC_CTL_UART2_RXD IOC_PC24_FUNC_CTL_UART2_TXD 0 0 0 0 IRQn_UART2 2

# UART6 - TELEM3 (uart_desc[6] -> SERIAL5)
HPMICRO_SERIAL HPM_UART6 clock_uart6 IOC_PAD_PC27 IOC_PAD_PC28 IOC_PC27_FUNC_CTL_UART6_RXD IOC_PC28_FUNC_CTL_UART6_TXD 0 0 0 0 IRQn_UART6 6

# UART1 - EXTERNAL2 UART (uart_desc[7] -> SERIAL6)
HPMICRO_SERIAL HPM_UART1 clock_uart1 IOC_PAD_PC18 IOC_PAD_PC19 IOC_PC18_FUNC_CTL_UART1_RXD IOC_PC19_FUNC_CTL_UART1_TXD 0 0 0 0 IRQn_UART1 1

# ========== CAN (schematic: 飞控CAN1=MCU CAN1, 飞控CAN2=MCU CAN2) ==========
# DF40 nets CAN1_TXD/RXD → PA20/PA19 (HPM CAN1); CAN2_TXD/RXD → PA25/PA24 (HPM CAN2)
# No FMU↔底板 CAN0. P1/D1 and P2/D2 are independent DroneCAN stacks.
CAN_ORDER 1 IOC_PAD_PA19 IOC_PAD_PA20 IOC_PA19_FUNC_CTL_CAN1_RXD 0 0 IOC_PA20_FUNC_CTL_CAN1_TXD 0 0 IRQn_CAN1 clock_can1
CAN_ORDER 2 IOC_PAD_PA24 IOC_PAD_PA25 IOC_PA24_FUNC_CTL_CAN2_RXD 0 0 IOC_PA25_FUNC_CTL_CAN2_TXD 0 0 IRQn_CAN2 clock_can2
define HAL_MAX_CAN_PROTOCOL_DRIVERS 2
# Per-driver Canard pool (independent of UART/I2C/NET heaps)
define DRONECAN_NODE_POOL_SIZE 4096
# Independent stacks (bytes); Scheduler maps UART/I2C/CAN/NET to COMM_PRIO
define DRONECAN_STACK_SIZE 4096
define HPM_NETWORK_STACK_BYTES 4096
define AP_NETWORKING_PORT_STACK_SIZE 2048
define CANARD_NUM_HANDLERS 2

# ========== SPI ==========
# SPI2 - ICM45686 on-board IMU (bus 0)
# Schematic: INT2/CLKIN fed by onboard 32.768kHz OSC1 (CLK32) — enable RTC/CLKIN + 20-bit hi-res
define ICM45686_CLKIN 1
define HAL_INS_HIGHRES_SAMPLE 1
define HAL_DEFAULT_INS_FAST_SAMPLE 1
HPMICRO_SPIBUS HPM_SPI2 clock_spi2 HPM_HDMA IRQn_HDMA 2 HPM_DMA_SRC_SPI2_TX 3 HPM_DMA_SRC_SPI2_RX IOC_PAD_PA27 IOC_PAD_PA31 IOC_PAD_PB00 IOC_PA27_FUNC_CTL_SPI2_MOSI IOC_PA31_FUNC_CTL_SPI2_MISO IOC_PB00_FUNC_CTL_SPI2_SCLK 0 0 0 0 0 0

# SPI0 - FM25V02A FRAM on PZ02..PZ05 (bus 1). PZ is battery-domain; route via BIOC SOC_PZ.
HPMICRO_SPIBUS HPM_SPI0 clock_spi0 HPM_HDMA IRQn_HDMA 0 HPM_DMA_SRC_SPI0_TX 1 HPM_DMA_SRC_SPI0_RX IOC_PAD_PZ04 IOC_PAD_PZ05 IOC_PAD_PZ03 IOC_PZ04_FUNC_CTL_SPI0_MOSI IOC_PZ05_FUNC_CTL_SPI0_MISO IOC_PZ03_FUNC_CTL_SPI0_SCLK BIOC_PZ04_FUNC_CTL_SOC_PZ_04 BIOC_PZ05_FUNC_CTL_SOC_PZ_05 BIOC_PZ03_FUNC_CTL_SOC_PZ_03 0 0 0

# SPI2 mux select (TMUX1574 SEL = SPI2_CSN1/PB06). High selects onboard IMU.
define HAL_HPM_SPI2_BOARD_MUX_PIN IOC_PAD_PB06

# SPI Devices
# ICM45686 on SPI2, CS=PC20 (SPI2_CSN2), mode 3
HPMICRO_SPIDEV icm45686 0 0 IOC_PAD_PC20 0 0 0 3 1*MHZ 10*MHZ
# FM25V02A FRAM on SPI0, CS=PZ02 (SPI0_CSN0), mode 3 — parameter storage
HPMICRO_SPIDEV ramtron 1 0 IOC_PAD_PZ02 0 BIOC_PZ02_FUNC_CTL_SOC_PZ_02 0 3 8*MHZ 8*MHZ

# ========== I2C ==========
# I2C2 - ICP20100 barometer on PB03/PB04 (bus 0, internal)
HPMICRO_I2CBUS HPM_I2C2 IOC_PAD_PB03 IOC_PAD_PB04 IOC_PB03_FUNC_CTL_I2C2_SDA IOC_PB04_FUNC_CTL_I2C2_SCL 0 0 0 0 clock_i2c2 400*KHZ true false
# I2C0 - GPS1 I2C (PB10 SDA / PB11 SCL, bus 1, external)
# Interface list: I2C0 = GPS1 I2C; M10 UART on SERIAL3 + IIS2MDC here
HPMICRO_I2CBUS HPM_I2C0 IOC_PAD_PB10 IOC_PAD_PB11 IOC_PB10_FUNC_CTL_I2C0_SDA IOC_PB11_FUNC_CTL_I2C0_SCL 0 0 0 0 clock_i2c0 100*KHZ false false

# IIS2MDC only via HAL_MAG_PROBE_LIST in board header (avoid full external sweep)
define AP_COMPASS_IIS2MDC_ENABLED 1
define AP_COMPASS_ENABLE_DEFAULT 1

# ========== ADC ==========
# Battery voltage monitoring (ADC0 channels)
HPMICRO_ADCPIN 15 2.0f 0 IOC_PAD_PE29 false HPM_ADC0 clock_adc0
# 3V3 sense
HPMICRO_ADCPIN 16 2.0f 1 IOC_PAD_PE30 false HPM_ADC0 clock_adc0
# Battery current / 5V sense
HPMICRO_ADCPIN 3 2.0f 2 IOC_PAD_PE17 false HPM_ADC1 clock_adc1

# ========== RCOUT (PWM outputs) ==========
# FMU_CH1-4: PWM3.P2/P3/P4/P7 on PD00/PD01/PD02/PC29
# FMU_CH5-8: TRGM1.P11/P09/P08/P10 on PC04/PC05/PC09/PC08 ← PWM1 ch8-11
# Second field = PWM channel index (not SERVO order)
HPMICRO_RCOUT IOC_PAD_PD00 2
HPMICRO_RCOUT IOC_PAD_PD01 3
HPMICRO_RCOUT IOC_PAD_PD02 4
HPMICRO_RCOUT IOC_PAD_PC29 7
HPMICRO_RCOUT IOC_PAD_PC04 8
HPMICRO_RCOUT IOC_PAD_PC05 9
HPMICRO_RCOUT IOC_PAD_PC09 10
HPMICRO_RCOUT IOC_PAD_PC08 11

# ========== GPIO ==========
# Safety switch input
HPMICRO_GPIO 0 IOC_PAD_PC16 true 0 0 nullptr
# Safety switch LED output
HPMICRO_GPIO 1 IOC_PAD_PC15 true 0 1 nullptr
# RGB LED - Red (PB12)
HPMICRO_GPIO 2 IOC_PAD_PB12 true 0 2 nullptr
# RGB LED - Green (PB09)
HPMICRO_GPIO 3 IOC_PAD_PB09 true 0 3 nullptr
# RGB LED - Blue (PB05)
HPMICRO_GPIO 4 IOC_PAD_PB05 true 0 4 nullptr
# Buzzer
HPMICRO_GPIO 5 IOC_PAD_PC25 true 0 5 nullptr
# Ethernet PHY 3V3 enable (VDD_3V3_ETH_EN)
HPMICRO_GPIO 6 IOC_PAD_PC13 true 0 6 nullptr
define HAL_GPIO_ETH_ENABLE 6

# ========== Other defines ==========
define HAL_USE_ADC 1
define AP_SERIALMANAGER_ENABLED    1
define AP_INERTIALSENSOR_ENABLED   1
define ALLOW_ARM_NO_COMPASS
define AP_RCPROTOCOL_ENABLED       1
define AP_MOTORS_FRAME_DEFAULT_ENABLED 0
define AP_MOTORS_FRAME_QUAD_ENABLED 1

# Parameter storage on FM25V02A FRAM (SPI0), not XPI NOR flash
define HAL_WITH_RAMTRON 1
define HAL_STORAGE_SIZE 16384
define HAL_RAMTRON_ALLOW_FALLBACK 0

# ADC settings
define HPM_ADC_SAMPLE_CYCLE 20
define HPM_ADC_PRESCALE_VALUE 22
define HPM_ADC_PERIOD_COUNT 5

define HPM_SPI_TIMEOUT_VALUE 100000

AUTOBUILD_TARGETS Copter
