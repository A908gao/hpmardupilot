# fmuv6x_hpm defaults
BRD_IO_ENABLE 2
NET_ENABLE 1
NET_DHCP 0
NET_IPADDR 192.168.144.14
NET_NETMASK 24
NET_GWADDR 192.168.144.1
# NET_P1: UDP server MAVLink2 on :14550 (GCS: udp:192.168.144.14:14550)
NET_P1_TYPE 2
NET_P1_PROTOCOL 2
NET_P1_PORT 14550
NET_P1_IP0 0
NET_P1_IP1 0
NET_P1_IP2 0
NET_P1_IP3 0
NTF_LED_TYPES 33
COMPASS_ENABLE 1
# SERIAL map: 0=USB 1=TELEM1/UART8 2=TELEM2/UART9 3=GPS1/UART3 4=GPS2/UART2
#              5=TELEM3/UART6 6=EXT2/UART1 7=RC-IO/UART5 8=Empty 9=DEBUG/UART0
SERIAL0_PROTOCOL 2
SERIAL0_BAUD 115
SERIAL1_PROTOCOL 2
SERIAL1_BAUD 57
SERIAL2_PROTOCOL 2
SERIAL2_BAUD 57
SERIAL3_PROTOCOL 5
SERIAL3_BAUD 230
SERIAL4_PROTOCOL 5
SERIAL4_BAUD 230
SERIAL5_PROTOCOL 2
SERIAL5_BAUD 57
# Leave EXT2/RC-IO/DEBUG free so NET_P1 can claim a GCS MAVLink slot
# (MAVLINK_COMM_NUM_BUFFERS=8; USB+TELEM1/2/3 already use 4)
SERIAL6_PROTOCOL -1
SERIAL6_BAUD 57
SERIAL7_PROTOCOL -1
SERIAL7_BAUD 1500
SERIAL8_PROTOCOL -1
SERIAL9_PROTOCOL -1
SERIAL9_BAUD 115
SR0_EXTRA1 4
SR0_EXTRA2 4
SR0_EXTRA3 4
SR0_POSITION 4
SR0_RAW_SENS 2
SR0_RC_CHAN 2
SR0_EXT_STAT 2
SR0_PARAMS 10
# Two independent DroneCAN stacks (MCU CAN1→P1/D1=飞控CAN1, MCU CAN2→P2/D2=飞控CAN2)
CAN_P1_DRIVER 1
CAN_D1_PROTOCOL 1
CAN_D1_UC_NODE 10
CAN_D1_UC_POOL 4096
CAN_P2_DRIVER 2
CAN_D2_PROTOCOL 1
CAN_D2_UC_NODE 11
CAN_D2_UC_POOL 4096
CAN_LOGLEVEL 1
